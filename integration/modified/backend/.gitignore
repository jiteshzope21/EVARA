# Environment
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/

# Models / data (large / generated artifacts)
saved_models/*
!saved_models/.gitkeep

# Phase 5: LoRA adapter and merged model outputs
saved_models/evara-lora-adapter/
saved_models/evara-merged/

# Hugging Face model cache (can be multi-GB)
# Default HF cache locations — exclude from Git
~/.cache/huggingface/
.cache/huggingface/
hf_cache/

# Training outputs / checkpoints
training/outputs/
training/runs/
training/logs/
runs/

# Processed / generated datasets (large)
# The raw synthetic source (data/synthetic/) IS committed (small, reproducible)
# The processed split (data/processed/) is regenerated by prepare_dataset.py
data/processed/*
!data/processed/.gitkeep

# Large generated datasets (leave the seed/example file in Git)
# Any auto-generated JSONL > ~100KB
data/synthetic/evara_synthetic_large*.jsonl

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
