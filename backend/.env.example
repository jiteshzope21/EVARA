# ---------------------------------------------------------------------------
# EVARA — Backend Environment Variables (example)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=sahaara_ai

# JWT authentication
JWT_SECRET=change-this-to-a-long-random-secret-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# SLM configuration (used starting Phase 2 / Phase 5)
SLM_MODEL=
MOCK_SLM=true
HF_TOKEN=

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
